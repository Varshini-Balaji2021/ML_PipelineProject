    mapping = {
        "median_income": "Expected positive association with house value.",
        "longitude": "Expected regional and nonlinear spatial variation.",
        "latitude": "Expected regional and nonlinear spatial variation.",
        "housing_median_age": "Possible nonlinear or threshold effect.",
        "total_rooms": "Ambiguous raw-scale effect; ratios may be more informative.",
