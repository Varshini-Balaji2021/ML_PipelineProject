def lowess_curvature_score(
    feature: pd.Series,
    target: pd.Series,
) -> tuple[float, pd.DataFrame]:
    frame = pd.DataFrame(
        {
            "feature": pd.to_numeric(feature, errors="coerce"),
            "target": pd.to_numeric(target, errors="coerce"),
        }
    ).dropna()

    if len(frame) < 50:
        return float("nan"), pd.DataFrame()

    if len(frame) > LOWESS_SAMPLE_SIZE:
        frame = frame.sample(
            n=LOWESS_SAMPLE_SIZE,
            random_state=42,
        )

    frame = frame.sort_values("feature")

    x = frame["feature"].to_numpy(dtype="float64")
    y = frame["target"].to_numpy(dtype="float64")

    if np.isclose(np.std(x), 0):
        return 0.0, pd.DataFrame()

    slope, intercept = np.polyfit(x, y, deg=1)
    linear_fitted = intercept + slope * x

    smooth = lowess(
        endog=y,
        exog=x,
        frac=LOWESS_FRACTION,
        return_sorted=True,
    )

    lowess_fitted = np.interp(
        x,
        smooth[:, 0],
        smooth[:, 1],
    )

    target_std = float(np.std(y, ddof=1))

    if np.isclose(target_std, 0):
        score = 0.0
    else:
        score = float(
            np.sqrt(
                np.mean((lowess_fitted - linear_fitted) ** 2)
            )
            / target_std
        )

    plot_data = pd.DataFrame(
        {
            "feature": x,
            "target": y,
            "linear_fitted": linear_fitted,
            "lowess_fitted": lowess_fitted,
        }
    )

    return score, plot_data


def classify_curvature(score: float) -> str:
    if not np.isfinite(score):
        return "Insufficient data"

    if score < MILD_CURVATURE_THRESHOLD:
        return "Nearly linear"

    if score < MODERATE_CURVATURE_THRESHOLD:
        return "Mild curvature"

    if score < STRONG_CURVATURE_THRESHOLD:
        return "Moderate curvature"

    return "Strong nonlinear pattern"


def curvature_implication(classification: str) -> str:
    if classification == "Nearly linear":
        return "A linear effect is a reasonable initial approximation."

    if classification == "Mild curvature":
        return (
            "Retain the linear baseline and inspect a polynomial "
            "or smooth alternative."
        )

    if classification == "Moderate curvature":
        return "Evaluate nonlinear polynomial and GAM effects."

    if classification == "Strong nonlinear pattern":
        return (
            "Do not rely only on a linear coefficient; compare "
            "nonlinear OLS and GAM specifications."
        )

    return "No modelling implication available."



def create_nonlinearity_screen(
    data: pd.DataFrame,
) -> pd.DataFrame:
    """
    Create a provisional LOWESS deviation screen.

    The automated pattern is not treated as the analyst's final decision.
    The generated figure and analyst-review fields are retained so that
    visual judgement, RESET, diagnostics, and validation can confirm or
    overturn the automated screen.
    """

    rows = []

    for feature in NUMERICAL_COLUMNS:
        if feature not in data.columns:
            continue

        score, plot_data = lowess_curvature_score(
            data[feature],
            data[TARGET_COLUMN],
        )

        automated_screen = classify_curvature(score)
        figure_name = f"lowess_{feature}.png"

        rows.append(
            {
                "feature": feature,
                "lowess_deviation_score": score,
                "automated_screen": automated_screen,
                "visual_evidence": (
                    "Review the corresponding LOWESS figure"
                ),
                "analyst_decision": "Not reviewed",
                "provisional_model_implication": (
                    curvature_implication(automated_screen)
                ),
                "figure_file": figure_name,
                "caution": (
                    "The automated screen is provisional. Confirm using "
                    "visual inspection, RESET, model diagnostics, validation, "
                    "and test evidence."
                ),
                # Retained for downstream computational compatibility.
                "exploratory_pattern": automated_screen,
            }
        )

        if plot_data.empty:
            continue

        plt.figure(figsize=(9, 6))
        plt.scatter(
            plot_data["feature"],
            plot_data["target"],
            alpha=0.15,
            s=10,
            label="Observations",
        )
        plt.plot(
            plot_data["feature"],
            plot_data["linear_fitted"],
            linewidth=2,
            label="Linear fit",
        )
        plt.plot(
            plot_data["feature"],
            plot_data["lowess_fitted"],
            linewidth=2,
            label="LOWESS",
        )
        plt.xlabel(feature)
        plt.ylabel(TARGET_COLUMN)
        plt.title(f"Exploratory Linearity Review: {feature}")
        plt.legend()
        plt.tight_layout()
        plt.savefig(
            FIGURES_DIR / figure_name,
            dpi=300,
        )
        plt.close()

    return (
        pd.DataFrame(rows)
        .sort_values("lowess_deviation_score", ascending=False)
        .reset_index(drop=True)
    )

def schema_based_reason(feature: str) -> str:
    rules = SEMANTIC_SCHEMA.get(feature, {})
    semantic_type = str(rules.get("semantic_type", "predictor"))

    if semantic_type == "spatial_coordinate":
        return (
            "Geographic position may capture regional market structure "
            "and nonlinear spatial effects."
        )

    if semantic_type == "count":
        return (
            "The variable may contribute through scale, density, ratio, "
            "or interaction effects."
        )

    if semantic_type == "nominal_categorical":
        return (
            "Systematic differences between categories may explain "
            "house-price variation."
        )

    if semantic_type == "discrete_numeric":
        return (
            "The variable may have a nonlinear or piecewise relationship "
            "with house value."
        )

    return (
        "The variable remains conceptually relevant and should be assessed "
        "jointly with other predictors."
    )


