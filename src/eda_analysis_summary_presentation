def create_modelling_challenges(
    data: pd.DataFrame,
    distributions: pd.DataFrame,
    correlation_screen: pd.DataFrame,
    nonlinearity: pd.DataFrame,
    outliers: pd.DataFrame,
) -> pd.DataFrame:
    """Group likely challenges into data, statistical, and structural issues."""

    rows = []

    target_row = distributions.loc[
        distributions["variable"] == TARGET_COLUMN
    ]

    if not target_row.empty:
        skewness = float(target_row.iloc[0]["skewness"])

        if abs(skewness) >= 0.75:
            rows.append(
                {
                    "challenge_group": "Statistical issue",
                    "challenge": "Response asymmetry",
                    "evidence": f"Response skewness = {skewness:.4f}.",
                    "implication": (
                        "Consider transformation only when it improves "
                        "validation or specification adequacy."
                    ),
                }
            )

    if int(data.isna().sum().sum()) > 0:
        rows.append(
            {
                "challenge_group": "Data issue",
                "challenge": "Missing predictor values",
                "evidence": (
                    "Missing values remain in: "
                    + ", ".join(
                        data.columns[
                            data.isna().sum() > 0
                        ].tolist()
                    )
                ),
                "implication": (
                    "Fit imputation using training data only."
                ),
            }
        )

    if not correlation_screen.empty:
        rows.append(
            {
                "challenge_group": "Statistical issue",
                "challenge": "High predictor association",
                "evidence": (
                    f"{len(correlation_screen)} predictor pair(s) "
                    f"have |r| >= {HIGH_PAIRWISE_CORRELATION:.2f}."
                ),
                "implication": (
                    "Run VIF and condition-number checks for inference; "
                    "retain for ML unless validation indicates otherwise."
                ),
            }
        )

    curved = nonlinearity.loc[
        nonlinearity["exploratory_pattern"].isin(
            ["Moderate curvature", "Strong nonlinear pattern"]
        ),
        "feature",
    ].tolist()

    if curved:
        rows.append(
            {
                "challenge_group": "Statistical issue",
                "challenge": "Possible nonlinear relationships",
                "evidence": ", ".join(curved),
                "implication": (
                    "Compare linear, nonlinear polynomial, and smooth "
                    "specifications; treat the LOWESS screen as provisional."
                ),
            }
        )

    high_outlier = outliers.loc[
        outliers["combined_flag_percentage"]
        >= MATERIAL_OUTLIER_PERCENTAGE
    ]

    if not high_outlier.empty:
        rows.append(
            {
                "challenge_group": "Data issue",
                "challenge": "Potential extreme observations",
                "evidence": ", ".join(
                    high_outlier["variable"].tolist()
                ),
                "implication": (
                    "Retain for prediction unless domain evidence supports "
                    "removal; perform sensitivity analysis for inference."
                ),
            }
        )

    rows.append(
        {
            "challenge_group": "Statistical issue",
            "challenge": "Potential omitted variables",
            "evidence": (
                "The available predictors may not fully measure local quality, "
                "accessibility, institutional conditions, or market expectations."
            ),
            "implication": (
                "Avoid causal claims and document the limits of the available "
                "data when interpreting coefficients."
            ),
        }
    )

