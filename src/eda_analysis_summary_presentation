def create_candidate_explanatory_variables(
    data: pd.DataFrame,
    target_correlations: pd.DataFrame,
    nonlinearity: pd.DataFrame,
    outliers: pd.DataFrame,
) -> pd.DataFrame:
    correlation_lookup = (
        target_correlations.set_index("feature")[
            "correlation_with_target"
        ].to_dict()
    )

    curvature_lookup = (
        nonlinearity.set_index("feature")[
            "exploratory_pattern"
        ].to_dict()
    )

    outlier_lookup = (
        outliers.set_index("variable")[
            "combined_flag_percentage"
        ].to_dict()
        if not outliers.empty
        else {}
    )

    rows = []

    for feature in data.columns:
        if feature == TARGET_COLUMN:
            continue

        correlation = float(
            correlation_lookup.get(feature, np.nan)
        )

        absolute_correlation = (
            abs(correlation)
            if np.isfinite(correlation)
            else np.nan
        )

        rows.append(
            {
                "feature": feature,
                "semantic_type": SEMANTIC_SCHEMA.get(
                    feature,
                    {},
                ).get(
                    "semantic_type",
                    "",
                ),
                "business_rationale": schema_based_reason(feature),
                "expected_relationship": expected_relationship(feature),
                "correlation_with_target": correlation,
                "observed_linear_association": (
                    classify_marginal_linear_association(
                        absolute_correlation
                    )
                    if np.isfinite(absolute_correlation)
                    else "Categorical predictor"
                ),
                "exploratory_nonlinearity": curvature_lookup.get(
                    feature,
                    "Not applicable",
                ),
                "potential_outlier_percentage": float(
                    outlier_lookup.get(feature, 0.0)
                ),
                "candidate_status": "RETAIN AS CANDIDATE",
                "final_decision_rule": (
                    "Use validation for ML; use theory, VIF/estimability, "
                    "specification, diagnostics, robust inference, and test "
                    "evidence for inference."
                ),
            }
        )

    return pd.DataFrame(rows)


