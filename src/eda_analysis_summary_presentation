def require_training_data() -> None:
    if not TRAIN_PATH.exists():
        raise FileNotFoundError(
            f"Training data not found: {TRAIN_PATH}\n"
            "Run split.py first."
        )


def read_optional_csv(filename: str) -> pd.DataFrame | None:
    file_path = EDA_DIR / filename
    if not file_path.exists():
        return None

    data = pd.read_csv(file_path)
    return None if data.empty else data


def numeric_columns(data: pd.DataFrame) -> list[str]:
    return [
        column
        for column in data.columns
        if pd.api.types.is_numeric_dtype(data[column].dtype)
    ]


def calculate_target_correlations(data: pd.DataFrame) -> pd.DataFrame:
    matrix = data.select_dtypes(include="number").corr()

    output = (
        matrix[TARGET_COLUMN]
        .drop(TARGET_COLUMN)
        .sort_values(key=lambda values: values.abs(), ascending=False)
        .rename("correlation_with_target")
        .reset_index()
        .rename(columns={"index": "feature"})
    )

    output["absolute_correlation"] = output["correlation_with_target"].abs()
    return output


def calculate_correlation_matrix(data: pd.DataFrame) -> pd.DataFrame:
    return data.select_dtypes(include="number").corr()


def calculate_outlier_summary(data: pd.DataFrame) -> pd.DataFrame:
    rows = []

    for column in numeric_columns(data):
        series = pd.to_numeric(data[column], errors="coerce")

        q1 = float(series.quantile(0.25))
        q3 = float(series.quantile(0.75))
        iqr = q3 - q1

        lower = q1 - 1.5 * iqr
        upper = q3 + 1.5 * iqr

        flag = (
            series.notna()
            & ((series < lower) | (series > upper))
        )

        rows.append(
            {
                "variable": column,
                "combined_flag_count": int(flag.sum()),
                "combined_flag_percentage": float(flag.mean() * 100),
            }
        )

    return pd.DataFrame(rows)


def calculate_distribution_summary(data: pd.DataFrame) -> pd.DataFrame:
    rows = []

    for column in numeric_columns(data):
        series = pd.to_numeric(data[column], errors="coerce")

        rows.append(
            {
                "variable": column,
                "skewness": float(series.skew()),
                "kurtosis": float(series.kurt()),
            }
        )

    return pd.DataFrame(rows)


